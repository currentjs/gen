<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Error - Your App</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="/app.js"></script>
</head>
<body class="bg-gray-50 text-gray-900">
  <div class="max-w-7xl mx-auto px-4">
    <div class="flex justify-center">
      <div class="w-full max-w-md">
        <div class="text-center mt-20">
          <div class="text-8xl font-bold text-red-500 mb-4">{{ statusCode }}</div>
          <h2 class="text-2xl font-semibold mb-3">Oops! Something went wrong</h2>
          <p class="text-gray-500 mb-6">{{ error }}</p>
          <div class="flex gap-2 justify-center">
            <button class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700" onclick="window.history.back()">Go Back</button>
            <a href="/" class="px-4 py-2 border border-gray-400 text-gray-600 rounded hover:bg-gray-100">Home Page</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
