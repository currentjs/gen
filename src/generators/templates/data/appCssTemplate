/* CurrentJS App Styles */

/* ===== SEARCHABLE SELECT WIDGET ===== */

.cjs-searchable-select {
  position: relative;
}

.cjs-searchable-select-results {
  position: absolute;
  z-index: 1000;
  background: #fff;
  border: 1px solid #ced4da;
  border-top: none;
  border-radius: 0 0 .375rem .375rem;
  max-height: 240px;
  overflow-y: auto;
  width: 100%;
  box-shadow: 0 4px 8px rgba(0, 0, 0, .1);
}

.cjs-searchable-select-results:empty {
  display: none;
}

.cjs-searchable-select-results .cjs-result-item {
  padding: .5rem .75rem;
  cursor: pointer;
  font-size: .9rem;
}

.cjs-searchable-select-results .cjs-result-item:hover {
  background: #f8f9fa;
}

.cjs-searchable-select-results .cjs-result-empty {
  padding: .5rem .75rem;
  color: #6c757d;
  font-size: .9rem;
}
